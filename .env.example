# Скопируйте в .env и заполните. .env не коммитится.
# Space-Track: https://www.space-track.org/auth/createAccount
SPACETRACK_USER=
SPACETRACK_PASSWORD=

# PostgreSQL в docker-compose (поменяйте пароль на сервере)
POSTGRES_USER=kh
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kh
# Порты сервисов на хосте (наружу — только REPORT_PORT)
REPORT_PORT=8000
INGEST_PORT=8001
ASSESSMENT_PORT=8002
# Оповещения в Telegram (необязательно): токен бота от @BotFather. Получатели подключаются сами:
# открыть бота и нажать Start — бот ответит «Оповещения подключены». TELEGRAM_CHAT_ID — ещё один
# получатель (id своего чата, не id бота), обычно не нужен. TELEGRAM_POLLING=0 — не принимать команды бота
# (если тот же токен уже опрашивает другой запущенный экземпляр сервиса).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Локально без Docker: DATABASE_URL не задан -> SQLite в data/app.db
