flowchart TB
    W(["Вариант начала<br/>(окно заданной длительности)"]) --> R1{{"R1. Есть стоп-фактор<br/>хотя бы по одному механизму?"}}
    R1 -- да --> NR["<b>Не рекомендуется</b>"]
    R1 -- нет --> R2{{"R2. Есть минуты<br/>без данных?"}}
    R2 -- да --> RV["<b>Нужно проверить</b><br/>нехватка данных ≠ хорошая новость"]
    R2 -- нет --> R3["<b>R3. Сравнение</b><br/>меньше минут «нежелательно»: сначала<br/>радиация, затем мусор; дальше — минуты<br/>без оценки потока, поток за выход,<br/>метеорные потоки"]
    R3 --> R4["<b>R4.</b> Один вариант лучше по радиации,<br/>другой по мусору → приоритет радиации,<br/>компромисс пишется явно"]
    R4 --> R5["<b>R5.</b> При равенстве — больший<br/>запас на задержку работ"]
    R5 --> R6{{"<b>R6.</b> Разница меньше 5 мин<br/>и меньше 20 % потока?"}}
    R6 -- да --> EQ["<b>Почти как лучший</b><br/>(равноценно)"]
    R6 -- нет --> BEST["<b>Лучший вариант</b><br/>или «хуже лучшего»"]
    NR --> R7
    RV --> R7
    R7{{"<b>R7.</b> Отпали все<br/>варианты?"}} -- "у всех стоп-фактор" --> NOW["«Подходящего времени нет»"]
    R7 -- "остальные без данных" --> INS["«Рекомендацию дать нельзя»"]

    classDef q fill:#fff4e5,stroke:#eda100,color:#0b0b0b
    classDef s fill:#e8f0fb,stroke:#2a78d6,color:#0b0b0b
    classDef c fill:#fbe3e3,stroke:#d03b3b,color:#0b0b0b
    classDef g fill:#eeeeec,stroke:#898781,color:#0b0b0b
    classDef ok fill:#e6f6ee,stroke:#0ca30c,color:#0b0b0b
    class R1,R2,R6,R7 q
    class W,R3,R4,R5 s
    class NR,NOW c
    class RV,INS g
    class EQ,BEST ok
