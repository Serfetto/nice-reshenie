flowchart TB
    REQ["<b>Запрос аналитика</b><br/>момент T · длительность выхода ·<br/>период поиска начала · плановое начало"] --> SLICE
    SLICE["<b>1. Срез данных «на момент T»</b><br/>видно только то, что было опубликовано до T"] --> ORB
    ORB["<b>2. Орбита МКС</b><br/>SGP4 по TLE, шаг 30 с: широта, долгота, высота,<br/>магнитное поле IGRF, ЮАА, геомагнитная широта"] --> RAD & MMOD
    RAD["<b>3а. Частицы от Солнца</b><br/>поток GOES → сколько долетает до МКС<br/>(жёсткость обрезания + Kp)<br/>прогноз на 6 ч, предупреждения SWPC"]
    MMOD["<b>3б. Мусор и метеороиды</b><br/>сближения с объектами каталога<br/>(проход зоны контроля 4 × 50 × 50 км)<br/>+ метеорные потоки NASA"]
    RAD --> CLS
    MMOD --> CLS
    CLS["<b>4. Класс каждой минуты</b><br/>стоп-фактор · нежелательно ·<br/>без замечаний · нет данных"] --> WIN
    WIN["<b>5. Варианты начала</b><br/>окна заданной длительности каждые 15 мин:<br/>минуты по классам, запас на задержку"] --> RULE
    RULE["<b>6. Правило выбора R1–R7</b><br/>лучший вариант, равноценные, почему"] --> EXP
    EXP["<b>7. Объяснение и доказательства</b><br/>каждый вывод → измерение → исходный файл,<br/>надёжность и «когда пересчитать»"] --> SAVE
    SAVE[("<b>Сохранённый расчёт</b><br/>запрос, версии, пороги,<br/>список исходных файлов")]

    classDef a fill:#e8f0fb,stroke:#2a78d6,color:#0b0b0b
    classDef r fill:#fdece4,stroke:#eb6834,color:#0b0b0b
    classDef m fill:#e6f6ee,stroke:#1baf7a,color:#0b0b0b
    classDef s fill:#fff4e5,stroke:#eda100,color:#0b0b0b
    class REQ,SLICE,ORB,CLS,WIN,RULE,EXP a
    class RAD r
    class MMOD m
    class SAVE s
