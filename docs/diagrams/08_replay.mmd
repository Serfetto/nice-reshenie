flowchart TB
    subgraph ARCH["Архив в базе — всё, что скачано (время UTC)"]
        A1["Предупреждение SWPC<br/>опубликовано 02:43"]
        A2["Элементы орбиты МКС<br/>созданы 01:46"]
        A3["Измерение GOES<br/>за 05:00"]
        A4["Итоговая сводка SWPC<br/>опубликована 09.06"]
    end
    CUT{{"Отсечка T = 08.06 03:00 UTC (06:00 МСК)<br/>сравнивается время публикации,<br/>а не время скачивания"}}
    A1 --> CUT
    A2 --> CUT
    A3 --> CUT
    A4 --> CUT
    CUT -- "видно" --> P["<b>Прогноз из прошлого</b><br/>ответ, который система<br/>дала бы в тот момент"]
    CUT -. "скрыто (вышло позже T)" .-> H["Будущее —<br/>недоступно ядру расчёта"]
    P --> V["<b>«Что было на самом деле»</b><br/>тот же расчёт по полному архиву →<br/>угадали / пропустили / ложные тревоги"]
    H -. "только для сверки" .-> V

    classDef s fill:#e8f0fb,stroke:#2a78d6,color:#0b0b0b
    classDef q fill:#fff4e5,stroke:#eda100,color:#0b0b0b
    classDef g fill:#eeeeec,stroke:#898781,color:#0b0b0b
    classDef ok fill:#e6f6ee,stroke:#1baf7a,color:#0b0b0b
    class A1,A2 s
    class A3,A4,H g
    class CUT q
    class P,V ok
