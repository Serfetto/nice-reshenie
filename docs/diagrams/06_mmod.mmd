flowchart TB
    CAT["Каталог Space-Track: объекты, чья орбита<br/>пересекает высоты МКС (перигей < 460 км,<br/>апогей > 380 км) — 1000–2000 в сутки"] --> FRESH{{"Элементы опубликованы<br/>до T и не старше 3 суток?"}}
    FRESH -- нет --> SKIP["не используются"]
    FRESH -- да --> PROP["Каждый объект и МКС — по SGP4<br/>на общей сетке 30 с (отбор рассчитан<br/>на скорость сближения до 16 км/с)"]
    PROP --> COORB{{"Летит вместе с МКС?<br/>(в среднем ближе 10 км или медианная<br/>относительная скорость < 0,1 км/с)"}}
    COORB -- "да: пристыкованные<br/>корабли и модули" --> EXCL["исключается"]
    COORB -- нет --> REF["Уточнение момента наибольшего<br/>сближения с шагом 0,5 с"]
    REF --> BOX{{"Проходит через зону контроля МКС?<br/>±2 км по высоте, ±25 км вдоль и поперёк"}}
    BOX -- да --> CRIT["<b>Стоп-фактор</b> на интервале<br/>момент сближения ± 10 мин<br/>+ скорость, угол, энергия 1 г вещества"]
    BOX -- нет --> INFO["Показывается как информация<br/>(если ближе 50 км)"]

